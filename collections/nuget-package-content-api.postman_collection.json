  "info": {
    "_postman_id": "26842963-d3b7-466c-b84f-546b1eb2b4da",
    "name": "NuGet Package Content API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The NuGet Package Content API, accessed through the PackageBaseAddress resource (also known as the flat container), allows clients to download package content files (.nupkg), package manifests (.nuspec), and enumerate all available versions for a given package ID. The flat container structure organizes packages by lowercase package ID and version, providing direct access to binary package files.\n\nContact Support:\n Name: NuGet Support",
      "type": "text/plain"
    }
  }
