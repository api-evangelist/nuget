    {
      "id": "9ba374c1-357b-4f17-ac50-b6a023fccef1",
      "name": "Package Content",
      "description": {
        "content": "Endpoints for enumerating package versions and downloading package content files (.nupkg) and manifests (.nuspec).",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "2733a8bc-b7a5-445c-a9a7-ce63ac54a4d9",
          "name": "Enumerate package versions",
          "request": {
            "name": "Enumerate package versions",
            "description": {
              "content": "Lists all available versions (both listed and unlisted) of a package. The versions returned can be used to construct URLs for downloading specific package content or manifests. Returns a 404 if the package source has no versions of the provided package ID.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":lowerId",
                "index.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "lowerId",
                  "description": "(Required) The package ID, lowercased using .NET ToLowerInvariant() rules."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
