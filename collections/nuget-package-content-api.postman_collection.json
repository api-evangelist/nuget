      "item": [
        {
          "id": "1b1e8778-e7d5-454f-aac8-0e7103bc9b7a",
          "name": "Enumerate package versions",
          "request": {
            "name": "Enumerate package versions",
            "description": {
              "content": "Lists all available versions (both listed and unlisted) of a package. The versions returned can be used to construct URLs for downloading specific package content or manifests. Returns a 404 if the package source has no versions of the provided package ID.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":lowerId",
                "index.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "lowerId",
                  "description": "(Required) The package ID, lowercased using .NET ToLowerInvariant() rules."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
