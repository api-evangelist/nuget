        {
          "id": "c1600d38-284d-4627-a92f-d6189bb9315e",
          "name": "Download package manifest (.nuspec)",
          "request": {
            "name": "Download package manifest (.nuspec)",
            "description": {
              "content": "Downloads the package manifest file (.nuspec) for a specific package ID and version. The .nuspec is an XML document containing the package metadata as originally authored. Both the package ID and version must be lowercased and the version normalized.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":lowerId",
                ":lowerVersion",
                "{{lowerId}}.nuspec"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "lowerVersion",
                  "description": "(Required) The package version, normalized and lowercased. SemVer 2.0.0 build metadata must be excluded."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "GET",
            "auth": null
