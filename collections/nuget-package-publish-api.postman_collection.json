          "name": "Delete or unlist a package",
          "request": {
            "name": "Delete or unlist a package",
            "description": {
              "content": "Deletes or unlists a package from the NuGet feed. On nuget.org, this operation unlists the package rather than performing a hard delete. Unlisted packages no longer appear in search results or the web interface but remain available for existing consumers.",
