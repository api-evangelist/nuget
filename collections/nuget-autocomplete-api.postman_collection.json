                      "value": "<string>"
                    },
                    {
                      "key": "prerelease",
                      "value": "false"
                    },
                    {
                      "key": "semVerLevel",
                      "value": "2.0.0"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"data\": [\n    \"string\",\n    \"string\"\n  ]\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
