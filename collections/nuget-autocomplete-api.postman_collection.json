{
  "item": [
    {
      "id": "75e2fc57-c2ea-41a8-af93-79ad76913c30",
      "name": "Autocomplete",
      "description": {
        "content": "Autocomplete package IDs and enumerate package versions for typeahead and discovery features.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "7c2c6d90-901b-43d4-8b2d-70e8dc7a1a8c",
          "name": "Autocomplete package IDs",
          "request": {
            "name": "Autocomplete package IDs",
            "description": {
              "content": "Searches for package IDs matching a substring. This endpoint supports typeahead features in user interfaces integrated with a NuGet package source. Packages with only unlisted versions do not appear in results. The base URL for this endpoint must be obtained from the service index using the SearchAutocompleteService resource type.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "autocomplete"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "The search terms used to filter packages. If not provided, all packages are returned within the boundaries of skip and take."
                },
                {
                  "disabled": false,
                  "key": "skip",
                  "value": "0",
                  "description": "The number of results to skip for pagination. Defaults to 0. On nuget.org, limited to 3000."
                },
                {
                  "disabled": false,
                  "key": "take",
                  "value": "<integer>",
                  "description": "The number of results to return for pagination. The server may impose a maximum value. On nuget.org, limited to 1000."
                },
                {
                  "disabled": false,
                  "key": "prerelease",
                  "value": "false",
                  "description": "When true, pre-release packages are included in results. Defaults to false, which excludes pre-release packages."
                },
                {
                  "disabled": false,
                  "key": "semVerLevel",
                  "value": "<string>",
                  "description": "A SemVer version string used to opt-in to SemVer 2.0.0 packages. If excluded, only SemVer 1.0.0 compatible versions are returned. Use 2.0.0 to include SemVer 2.0.0 packages."
                },
                {
                  "disabled": false,
                  "key": "packageType",
                  "value": "<string>",
                  "description": "The package type name to filter results. Added in SearchQueryService/3.5.0. If empty or not provided, no filter is applied."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "67d7c43a-6807-4040-9a16-0d4032cde52a",
              "name": "Successful autocomplete results",
              "originalRequest": {
                "url": {
                  "path": [
                    "autocomplete"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "q",
                      "value": "<string>"
                    },
                    {
                      "key": "skip",
                      "value": "0"
                    },
                    {
                      "key": "take",
                      "value": "<integer>"
                    },
                    {
                      "key": "prerelease",
                      "value": "false"
                    },
                    {
                      "key": "semVerLevel",
                      "value": "2.0.0"
                    },
                    {
                      "key": "packageType",
                      "value": "<string>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"totalHits\": 3167,\n  \"data\": [\n    \"string\",\n    \"string\"\n  ]\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        },
        {
          "id": "82404b52-6499-4797-8129-27a01dbe9a3c",
          "name": "Enumerate package versions",
          "request": {
            "name": "Enumerate package versions",
            "description": {
              "content": "Enumerates all listed versions for a given package ID. Unlisted versions do not appear in the results. This endpoint uses the same SearchAutocompleteService base URL with the id parameter instead of the q parameter.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "autocomplete-versions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<string>",
                  "description": "(Required) The package ID to fetch versions for."
                },
                {
                  "disabled": false,
                  "key": "prerelease",
                  "value": "false",
                  "description": "When true, pre-release packages are included in results. Defaults to false, which excludes pre-release packages."
                },
                {
                  "disabled": false,
                  "key": "semVerLevel",
                  "value": "<string>",
                  "description": "A SemVer version string used to opt-in to SemVer 2.0.0 packages. If excluded, only SemVer 1.0.0 compatible versions are returned. Use 2.0.0 to include SemVer 2.0.0 packages."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "02b00bd1-44cd-4b78-aaf7-6853a507eefe",
              "name": "Successful version enumeration results",
              "originalRequest": {
