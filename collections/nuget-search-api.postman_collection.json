        {
          "id": "2aa1668b-2bb0-4076-846c-090e54d8750e",
          "name": "Enumerate package versions",
          "request": {
            "name": "Enumerate package versions",
            "description": {
              "content": "Enumerates all listed versions for a given package ID. Unlisted versions do not appear in the results. This endpoint uses the same SearchAutocompleteService base URL with the id parameter instead of the q parameter.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "autocomplete-versions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<string>",
                  "description": "(Required) The package ID to fetch versions for."
                },
                {
                  "disabled": false,
                  "key": "prerelease",
                  "value": "false",
                  "description": "When true, pre-release packages are included in results. Defaults to false, which excludes pre-release packages."
                },
